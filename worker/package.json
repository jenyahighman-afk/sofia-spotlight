{
  "name": "sofia-spotlight-coach",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that proxies coach reviews to the Anthropic Messages API for Sofia's Spotlight.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "login": "wrangler login",
    "secret": "wrangler secret put ANTHROPIC_API_KEY",
    "kv": "wrangler kv namespace create RATE"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
